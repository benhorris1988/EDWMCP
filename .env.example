# Copy to .env and adjust. Settings are also overridable via CLI flags.

# Transport: "stdio" for local LLM hosts that spawn the MCP server as a subprocess,
# or "streamable-http" to expose it over HTTP (e.g. for a remote Kinetica LLM).
EDWMCP_TRANSPORT=stdio
EDWMCP_HTTP_HOST=0.0.0.0
EDWMCP_HTTP_PORT=8765

# Path to the skills config (YAML). See config.example.yaml.
EDWMCP_CONFIG=./config.example.yaml

# SQLAlchemy URL for the on-prem Enterprise Data Warehouse.
# Examples:
#   mssql+pyodbc://user:pass@host:1433/db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#   postgresql+psycopg://user:pass@host:5432/edw
#   teradatasql://user:pass@host/?database=edw
#   oracle+oracledb://user:pass@host:1521/?service_name=EDW
EDWMCP_EDW_URL=

# SQLAlchemy URL for the badminton MS SQL Server database.
EDWMCP_BADMINTON_URL=

# Safety limits applied to any LLM-driven SELECT query.
EDWMCP_QUERY_MAX_ROWS=500
EDWMCP_QUERY_TIMEOUT_SECONDS=30

# Set to 1 to ignore the URLs above and run against a seeded SQLite demo DB.
# Useful for trying the server end-to-end before wiring up the real warehouse.
EDWMCP_DEMO=0

# --- Admin API ---
# Bearer token required by the admin REST API used by the Flutter config app.
# If unset and EDWMCP_ADMIN_INSECURE != 1, the admin API refuses to start.
EDWMCP_ADMIN_TOKEN=
# Set to 1 to allow the admin API to run without a token (loopback dev only).
EDWMCP_ADMIN_INSECURE=0
# Comma-separated list of allowed CORS origins for the admin API.
# Use * to allow all (fine for an internal tool on a private network).
EDWMCP_ADMIN_CORS_ORIGINS=*
EDWMCP_ADMIN_HOST=127.0.0.1
EDWMCP_ADMIN_PORT=8766
